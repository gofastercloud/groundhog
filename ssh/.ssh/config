# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
Include ~/.orbstack/ssh/config
Include ~/.ssh/config.d/*
Include ~/.ssh/config.local

# GitHub: prefer Secure Enclave (Secretive), with optional FIDO2 break-glass
Host github.com
  IdentityFile ~/.ssh/id_secretive.pub
  IdentityFile ~/.ssh/id_ed25519_sk
  IdentitiesOnly yes
  AddKeysToAgent no

# Defaults: Secretive Secure Enclave agent, PQC-first KEX, AEAD ciphers, ETM MACs
Host *
  IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
  IdentityFile ~/.ssh/id_secretive.pub
  IdentityFile ~/.ssh/id_ed25519_sk
  IdentitiesOnly yes
  AddKeysToAgent no
  # Agent forwarding stays off; pass `ssh -A` only when genuinely required.
  ForwardAgent no
  HashKnownHosts yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512,sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org
  Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
  MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com
  HostKeyAlgorithms ssh-ed25519-cert-v01@openssh.com,ssh-ed25519,ecdsa-sha2-nistp256-cert-v01@openssh.com,ecdsa-sha2-nistp256,rsa-sha2-512-cert-v01@openssh.com,rsa-sha2-512,rsa-sha2-256-cert-v01@openssh.com,rsa-sha2-256
  PubkeyAcceptedAlgorithms sk-ssh-ed25519@openssh.com,ecdsa-sha2-nistp256,ssh-ed25519,sk-ecdsa-sha2-nistp256@openssh.com,ecdsa-sha2-nistp384
