---
extends: default
rules:
  braces:
    forbid: false
    max-spaces-inside: 1
    min-spaces-inside: 0
  commas: disable
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  document-start: disable
  line-length:
    max: 140
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
