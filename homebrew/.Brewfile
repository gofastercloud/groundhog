tap "jandedobbeleer/oh-my-posh"

# Core packages for a modern macOS developer workstation.
# Personal, hardware-specific, cloud/AI, and Mac App Store packages belong in
# custom/Brewfile (private overlay) or homebrew/.Brewfile.local (per-machine).

# ── Shell & terminal ─────────────────────────────────────────────────
brew "atuin"                        # Smart shell history
brew "carapace"                     # Multi-shell completions (nushell)
brew "fzf"                          # Fuzzy finder
brew "jandedobbeleer/oh-my-posh/oh-my-posh"  # Prompt theme engine
brew "mosh"                         # Resilient remote shell
brew "nushell"                      # Structured-data shell (default interactive shell)
brew "sesh"                         # tmux session manager
brew "tmux"                         # Terminal multiplexer
brew "vivid"                        # LS_COLORS generator (nushell ls)
brew "zoxide"                       # Smarter cd command
brew "zsh-completions"              # Additional completions for zsh
brew "zsh-fast-syntax-highlighting" # Syntax highlighting for zsh

# ── Modern CLI replacements ──────────────────────────────────────────
brew "ast-grep"                     # AST-based structural code search and rewrite
brew "bat"                          # cat replacement with syntax highlighting
brew "btop"                         # Resource monitor
brew "duf"                          # df replacement (disk free)
brew "dust"                         # du replacement (intuitive disk usage)
brew "eza"                          # ls replacement
brew "fd"                           # find replacement
brew "hyperfine"                    # CLI benchmarking
brew "ouch"                         # Universal compress/decompress
brew "procs"                        # ps replacement
brew "ripgrep"                      # grep replacement
brew "tokei"                        # Code statistics by language
brew "yazi"                         # Terminal file manager

# ── Git ──────────────────────────────────────────────────────────────
brew "difftastic"                   # Syntax-aware structural diffs
brew "gh"                           # GitHub CLI
brew "git"                          # Version control
brew "git-delta"                    # Better git diffs
brew "git-filter-repo"              # Git history rewriting tool
brew "git-lfs"                      # Git large file storage
brew "gitleaks"                     # Secret scanner
brew "lazygit"                      # Terminal UI for git
brew "pre-commit"                   # Git pre-commit hook framework

# ── Languages & runtimes ─────────────────────────────────────────────
brew "bun"                          # JS runtime and bundler
brew "cmake"                        # Cross-platform build system
brew "go"                           # Go toolchain
brew "lua-language-server"          # Lua LSP (for Neovim config)
brew "mise"                         # Polyglot runtime manager (Node, etc.)
brew "neovim"                       # Modern vim
brew "pyright"                      # Python LSP used by Neovim
brew "python@3.14"                  # Homebrew tooling runtime; projects use uv
brew "ruff"                         # Fast Python linter and formatter
brew "tree-sitter-cli"              # Builds nvim-treesitter parsers
brew "ty"                           # Fast Rust Python type checker (Astral)
brew "typescript-language-server"  # TypeScript LSP used by Neovim
brew "uv"                           # Fast Python package manager

# ── DevOps & linting ─────────────────────────────────────────────────
brew "ansible"                      # Automation and configuration management
brew "ansible-lint"                 # Ansible linting
brew "hadolint"                     # Dockerfile linter
brew "osv-scanner"                  # Dependency vulnerability scanner
brew "shellcheck"                   # Shell script linting
brew "yamllint"                     # YAML linting
brew "yq"                           # YAML processor

# ── Networking ───────────────────────────────────────────────────────
brew "iproute2mac"                  # Linux iproute2 commands for macOS
brew "mtr"                          # Network diagnostic tool
brew "oha"                          # HTTP load generator with HTTP/2 and structured output

# ── Security ─────────────────────────────────────────────────────────
brew "openssh"                      # OpenSSH with PQC KEX and FIDO2 support
brew "pam-reattach"                 # Touch ID support in tmux
brew "trufflehog"                   # Secret scanning tool

# ── Utilities ────────────────────────────────────────────────────────
brew "coreutils"                    # GNU file, shell, and text utilities
brew "dockutil"                     # Manage macOS dock items (used by Ansible dock role)
brew "duti"                         # Set default macOS file/URL handlers (used by Ansible defaults)
brew "glow"                         # Markdown renderer for terminal
brew "gum"                          # Interactive shell scripts
brew "jq"                           # JSON processor
brew "mas"                          # Mac App Store CLI (used if custom/Brewfile declares mas apps)
brew "stow"                         # Symlink farm manager for dotfiles
brew "watch"                        # Execute commands periodically

# ── Desktop applications ─────────────────────────────────────────────
cask "betterdisplay"                # Display management
cask "ghostty"                      # GPU-accelerated terminal
cask "google-chrome"                # Web browser
cask "orbstack"                     # Docker/Linux on macOS
cask "raycast"                      # Launcher and productivity tool
cask "secretive"                    # Secure Enclave SSH key manager and agent
cask "shottr"                       # Screenshot tool
cask "tailscale-app"                # Mesh VPN
cask "visual-studio-code"           # VS Code editor

# ── Fonts ────────────────────────────────────────────────────────────
cask "font-ioskeley-mono-term-nerd-font" # Ioskeley Mono Term — primary terminal/editor font
cask "font-ibm-plex-mono"           # IBM Plex Mono

# ── VS Code extensions ───────────────────────────────────────────────
vscode "asvetliakov.vscode-neovim"
vscode "astro-build.astro-vscode"
vscode "catppuccin.catppuccin-vsc"
vscode "catppuccin.catppuccin-vsc-icons"
vscode "charliermarsh.ruff"
vscode "dbaeumer.vscode-eslint"
vscode "esbenp.prettier-vscode"
vscode "golang.go"
vscode "michelemelluso.gitignore"
vscode "ms-azuretools.vscode-containers"
vscode "ms-python.debugpy"
vscode "ms-python.python"
vscode "ms-python.vscode-pylance"
vscode "ms-python.vscode-python-envs"
vscode "ms-vscode-remote.remote-containers"
vscode "ms-vscode-remote.remote-ssh"
vscode "ms-vscode-remote.remote-ssh-edit"
vscode "ms-vscode.live-server"
vscode "ms-vscode.remote-explorer"
vscode "philstainer.git-worktree"
vscode "redhat.vscode-yaml"
vscode "svelte.svelte-vscode"
vscode "the0807.uv-toolkit"
vscode "yy0931.vscode-sqlite3-editor"
