{
	"javascript.updateImportsOnFileMove.enabled": "always",
	"workbench.fontAliasing": "auto",
	"workbench.editor.highlightModifiedTabs": true,
	"javascript.preferences.quoteStyle": "single",
	"xml.preferences.quoteStyle": "single",
	"editor.accessibilitySupport": "off",
	"editor.inlineSuggest.enabled": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit",
	},
	"files.autoSave": "onFocusChange",
	"json.schemas": [],
	"typescript.updateImportsOnFileMove.enabled": "always",
	"prettier.proseWrap": "always",
	"editor.lineNumbers": "on",
	"javascript.format.insertSpaceAfterOpeningAndBeforeClosingTemplateStringBraces": true,
	"editor.formatOnSave": true,
	"editor.fontFamily": "IoskeleyMonoTerm Nerd Font Mono",
	"prettier.jsxSingleQuote": true,
	"editor.linkedEditing": true,
	"yaml.validate": false,
	"editor.insertSpaces": false,
	"[javascript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
	},
	"emmet.triggerExpansionOnTab": true,
	"markdown.preview.fontFamily": "IoskeleyMonoTerm Nerd Font Mono",
	"[jsonc]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
	},
	"editor.cursorStyle": "line",
	"vim.sneakReplacesF": true,
	"javascript.format.placeOpenBraceOnNewLineForFunctions": true,
	"emmet.includeLanguages": {
		"javascript": "javascriptreact",
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
	},
	"editor.wordWrap": "on",
	"typescript.format.placeOpenBraceOnNewLineForFunctions": true,
	"telemetry.telemetryLevel": "off",
	"editor.tabCompletion": "on",
	"yaml.customTags": [
		"!And",
		"!If",
		"!Not",
		"!Equals",
		"!Or",
		"!FindInMap sequence",
		"!Base64",
		"!Cidr",
		"!Ref",
		"!Sub",
		"!GetAtt",
		"!GetAZs",
		"!ImportValue",
		"!Select",
		"!Select sequence",
		"!Split",
		"!Join sequence",
		"!And sequence",
		"!If sequence",
		"!Not sequence",
		"!Equals sequence",
		"!Or sequence",
		"!FindInMap",
		"!Join",
		"!Sub sequence",
		"!ImportValue sequence",
		"!Split sequence",
	],
	// Enable/disable default YAML formatter (requires restart)
	"yaml.format.enable": true,
	"security.workspace.trust.untrustedFiles": "prompt",
	"eslint.rules.customizations": [
		{
			"react/jsx-first-prop-new-line": [2, "always"],
			"react/jsx-indent-props": [2, 2],
			"react/jsx-max-props-per-line": [
				2,
				{
					"maximum": 1,
					"when": "always",
				},
			],
			"react/jsx-closing-bracket-location": [2, "tag-aligned"],
		},
	],
	"editor.suggestSelection": "first",
	"redhat.telemetry.enabled": false,
	"yaml.format.singleQuote": true,
	"debug.console.fontFamily": "IoskeleyMonoTerm Nerd Font Mono",
	"workbench.startupEditor": "newUntitledFile",
	"prettier.singleQuote": true,
	"editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
	"explorer.confirmDragAndDrop": false,
	"typescript.preferences.quoteStyle": "single",
	"javascript.format.placeOpenBraceOnNewLineForControlBlocks": true,
	"typescript.format.placeOpenBraceOnNewLineForControlBlocks": true,
	"aws.samcli.enableCodeLenses": false,
	"editor.suggest.showMethods": true,
	"editor.suggest.preview": true,
	"editor.acceptSuggestionOnEnter": "on",
	"editor.snippetSuggestions": "top",
	"editor.guides.indentation": false,
	"editor.tabSize": 2,
	"editor.codeLensFontFamily": "IoskeleyMonoTerm Nerd Font Mono",
	"terminal.integrated.profiles.osx": {
		"nu": {
			"path": "/opt/homebrew/bin/nu",
			"icon": "terminal",
		},
		"zsh": {
			"path": "/bin/zsh",
			"args": ["-l"],
		},
	},
	// VS Code resolves the zsh login environment itself, so nu can start directly.
	"terminal.integrated.defaultProfile.osx": "nu",
	// Tasks and debuggers keep zsh for POSIX-compatible command lines.
	"terminal.integrated.automationProfile.osx": {
		"path": "/bin/zsh",
	},
	"prettier.bracketSameLine": true,
	"prettier.useTabs": true,
	"editor.hover.enabled": "on",
	"[yaml]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
	},
	"[markdown]": {
		"editor.unicodeHighlight.ambiguousCharacters": false,
		"editor.unicodeHighlight.invisibleCharacters": false,
		"editor.wordWrap": "on",
		"editor.quickSuggestions": {
			"comments": "off",
			"strings": "off",
			"other": "off",
		},
	},
	"prettier.singleAttributePerLine": true,
	"eslint.useESLintClass": true,
	"extensions.ignoreRecommendations": true,
	"git.enableSmartCommit": true,
	"git.autofetch": true,
	"python.defaultInterpreterPath": "",
	"aws.suppressPrompts": {},
	"[json]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
	},
	"extensions.experimental.affinity": {
		"asvetliakov.vscode-neovim": 1,
	},
	"terminal.explorerKind": "external",
	"emmet.useInlineCompletions": true,
	"editor.quickSuggestions": {
		"other": "inline",
	},
	"editor.bracketPairColorization.independentColorPoolPerBracketType": true,
	"editor.copyWithSyntaxHighlighting": false,
	"editor.foldingImportsByDefault": true,
	"update.showReleaseNotes": false,
	"auto-close-tag.activationOnLanguage": [
		"xml",
		"php",
		"blade",
		"ejs",
		"jinja",
		"javascript",
		"javascriptreact",
		"typescript",
		"typescriptreact",
		"plaintext",
		"markdown",
		"vue",
		"liquid",
		"erb",
		"lang-cfml",
		"cfml",
		"HTML (EEx)",
		"HTML (Eex)",
		"plist",
	],
	"auto-close-tag.disableOnLanguage": [],
	"aws.telemetry": false,
	"sortLines.filterBlankLines": true,
	"github.copilot.enable": {
		"*": true,
		"plaintext": false,
		"markdown": false,
		"scminput": false,
	},
	"github.copilot.editor.enableAutoCompletions": true,
	"editor.inlineSuggest.fontFamily": "IoskeleyMonoTerm Nerd Font Mono",
	"chat.editor.fontFamily": "IoskeleyMonoTerm Nerd Font Mono",
	"github.copilot.advanced": {},
	"workbench.colorTheme": "Catppuccin Mocha",
	"editor.fontSize": 15,
	"debug.console.fontSize": 15,
	"scm.inputFontSize": 15,
	"terminal.integrated.fontSize": 15,
	"chat.editor.fontSize": 15,
	"markdown.preview.fontSize": 15,
	"tailwindCSS.rootFontSize": 15,
	"jupyter.enableExtendedPythonKernelCompletions": true,
	"python.analysis.inlayHints.callArgumentNames": "all",
	"python.analysis.inlayHints.functionReturnTypes": true,
	"python.analysis.inlayHints.pytestParameters": true,
	"python.analysis.inlayHints.variableTypes": true,
	"[python]": {
		"editor.defaultFormatter": "charliermarsh.ruff",
		"editor.formatOnSave": true,
	},
	"continue.telemetryEnabled": false,
	"window.newWindowProfile": "Default",
	"editor.mouseWheelZoom": true,
	"editor.formatOnPaste": true,
	"editor.autoIndentOnPaste": true,
	"workbench.iconTheme": "catppuccin-mocha",
	"python.terminal.shellIntegration.enabled": true,
	"python.analysis.supportAllPythonDocuments": true,
	"livePreview.portNumber": 8888,
	"explorer.confirmDelete": false,
	"python.analysis.typeCheckingMode": "strict",
	"gitlens.ai.model": "vscode",
	"claudeCode.preferredLocation": "panel",
	"workbench.editor.empty.hint": "hidden",
	"terminal.external.osxExec": "Ghostty.app",
	"terminal.integrated.fontLigatures.enabled": true,
	"chat.fontFamily": "IoskeleyMonoTerm Nerd Font Mono",
	"notebook.markup.fontFamily": "IoskeleyMonoTerm Nerd Font Mono",
	"terminal.integrated.fontFamily": "IoskeleyMonoTerm Nerd Font Mono",
	"security.promptForLocalFileProtocolHandling": true,
	"svelte.enable-ts-plugin": true,
	"vsicons.dontShowNewVersionMessage": true,
	"terminal.integrated.initialHint": false,
}
